# ============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - ROMA PWA (6-8 NOVIEMBRE)
# ============================================================================

# 1. CREDENCIALES DEL GRUPO (Opcional, por defecto usuario roma2026 y clave spqr2026)
VITE_AUTH_USERNAME=roma2026
VITE_AUTH_PASSWORD_HASH=

# 2. BACKEND SUPABASE PARA ÁLBUM DE FOTOS COMPARTIDO EN LA NUBE (Opcional en local)
# Si se configuran estas variables, las fotos se sincronizan en tiempo real con
# Supabase Storage + PostgreSQL entre los móviles de Laura, José Antonio, Mónica y José Vicente.
# Si se dejan vacías, la aplicación funciona automáticamente con IndexedDB local + fotos de muestra.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

